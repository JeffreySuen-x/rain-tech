[Unit]
Description=Shuyu single persistent worker
After=network.target
[Service]
User=shuyu
Group=shuyu
WorkingDirectory=/opt/shuyu
EnvironmentFile=/etc/shuyu.env
ExecStart=/opt/shuyu/server/.venv/bin/python -m server.app worker
Restart=on-failure
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/shuyu
[Install]
WantedBy=multi-user.target
