SHUYU_ENV=production
SHUYU_DB=/var/lib/shuyu/shuyu.sqlite3
SHUYU_ASSET_ROOT=/var/lib/shuyu/assets
SHUYU_PUBLIC_ORIGIN=https://shuyu.example.com
# Configure a new 32+ character secret and provider credentials outside Git.
# SHUYU_SECRET=
# SHUYU_PROVIDER_URL=https://provider.example.com/v1
# SHUYU_PROVIDER_MODEL=
# SHUYU_PROVIDER_KEY=
SHUYU_PROVIDER_CAPABILITIES=text
SHUYU_PROVIDER_ASR_ADAPTER=transcriptions
# Optional: SHUYU_PROVIDER_VISION_MODEL, SHUYU_PROVIDER_ASR_MODEL
# Enable vision/asr only when supported by the configured service.
# Optional: SHUYU_PROVIDER_THINKING=disabled
