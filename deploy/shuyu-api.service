[Unit]
Description=Shuyu API (single process)
After=network.target
[Service]
User=shuyu
Group=shuyu
WorkingDirectory=/opt/shuyu
EnvironmentFile=/etc/shuyu.env
ExecStart=/opt/shuyu/server/.venv/bin/gunicorn --workers 1 --bind 127.0.0.1:6480 'server.app:create_app()'
Restart=on-failure
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/shuyu
[Install]
WantedBy=multi-user.target
