# Include this file from nginx's http {} context. Replace domain/cert paths.
# Log method and path only; exclude query strings, cookies and request bodies.
log_format shuyu_minimal '$request_method $uri $status $request_time';
limit_req_zone $binary_remote_addr zone=shuyu_login:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=shuyu_api:10m rate=10r/s;
server {
    listen 80;
    access_log /var/log/nginx/shuyu_access.log shuyu_minimal;
    server_name shuyu.example.com;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    access_log /var/log/nginx/shuyu_access.log shuyu_minimal;
    server_name shuyu.example.com;
    ssl_certificate /etc/letsencrypt/live/shuyu.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/shuyu.example.com/privkey.pem;
    root /opt/shuyu/web/dist;
    # Multipart allowance; application still validates each asset and JSON body.
    client_max_body_size 22m;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    location = /api/v1/auth/login {
        limit_req zone=shuyu_login burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:6480;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 30s;
    }
    location /api/ {
        limit_req zone=shuyu_api burst=30 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:6480;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 30s;
    }
    location / { try_files $uri $uri/ /index.html; }
}
